# .env.example
# Скопируйте в .env.local и заполните реальные значения.
# Все NEXT_PUBLIC_ переменные доступны на клиенте — только публичные данные.

# ── Контакты (публичные) ──
NEXT_PUBLIC_TG_LINK=https://t.me/fexperience
NEXT_PUBLIC_EMAIL=FExperience@forbes.ru
NEXT_PUBLIC_PHONE=+79201949003

# ── URL сайта (для OG-тегов и canonical) ──
NEXT_PUBLIC_SITE_URL=https://fexperience.forbes.ru

# ── Яндекс.Метрика ──
NEXT_PUBLIC_YANDEX_METRIKA_ID=your_metrika_id_here

# ── Форма заявки — через nodemailer (src/lib/mail.ts) ──
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=FExperience@forbes.ru

# ── AmoCRM webhook (src/app/api/lead/route.ts) — опционально ──
AMOCRM_WEBHOOK_URL=

# Если используется CMS в будущем
# SANITY_PROJECT_ID=
# SANITY_DATASET=
# SANITY_API_TOKEN=
